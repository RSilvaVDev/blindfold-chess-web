# Copy to .env and fill in. Never commit .env.
# VITE_ values are bundled into the public build: public values only.
VITE_API_URL=http://localhost:3000

# Supabase project URL and publishable key (Project Settings > API Keys).
# Never the secret key (sb_secret_...) or the legacy anon key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
